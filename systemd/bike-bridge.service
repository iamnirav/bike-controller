# bike-controller bridge, run as a system service.
#
# Shell backgrounding over SSH (nohup/setsid/&) is unreliable here: the process
# does not consistently survive the SSH channel closing, and two overlapping
# instances will fight over the controller grab. Use systemd.
#
# Install:
#   sudo cp systemd/bike-bridge.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl start bike-bridge      # now
#   sudo systemctl enable bike-bridge     # and on boot
#
# Watch it:      sudo journalctl -u bike-bridge -f
# Stop it:       sudo systemctl stop bike-bridge
#
# Edit ExecStart below to change mapping options. Drop --simulate-bike and give
# the real bike address (or omit --address entirely to autodiscover by name).
[Unit]
Description=bike-controller bridge (bike + gamepad -> virtual Xbox pad)
After=bluetooth.target
Wants=bluetooth.target

[Service]
# notify + WatchdogSec turns "the process exists" into "the process is still
# emitting frames". Restart=on-failure only catches a process that EXITS; a
# stalled output loop leaves the uinput device latched at its last values --
# stick deflected, gate open -- with systemd reporting the unit healthy.
Type=notify
WatchdogSec=15
# Needs root for /dev/uinput and for EVIOCGRAB on the controller.
User=root
WorkingDirectory=/home/nirav/bike-controller
# Bike MAC as seen from Linux (differs from the UUID macOS reports).
# Omit --address entirely to autodiscover by advertised name instead.
# Movement speed scales with POWER (watts), so resistance sets the character of
# the workout: high resistance means pedal slow and hard, low means fast and
# light, and either can reach full speed.
#
# --movement-min defaults to 0, which lets the GAME's own stick deadzone be the
# threshold you must clear before moving (typically 12-24% of full deflection).
# Two problems solved by one number.
#
# Sprint HOLDS left stick click (BTN_THUMBL) while above 125W -- it is held,
# not toggled, so set games to "hold to sprint".
#
# Thresholds came down with each real ride: 130/150 (from one capture) ->
# 100/125 -> 75/100. Ride data beats arithmetic.
#
# --poll-interval 0.05 was measured, not guessed: 0.2s gives 0.77Hz telemetry,
# 0.1 gives 1.95Hz, 0.05 gives 2.56Hz, 0.02 gives 2.74Hz. It plateaus around
# 2.7Hz -- the console's own update ceiling -- so 0.05 is the knee, and going
# lower quadruples BLE traffic for ~7%.
#
# --ride-log writes one CSV per run, only while you are actually pedalling.
# It lives OUTSIDE the repo on purpose: tools/deploy.sh rsyncs with --delete,
# so a rides/ directory inside the checkout would be erased on every deploy.
# Analyse with: python3 tools/ride_report.py ~/bike-rides/
#
# --launch-on-input opens Xbox Remote Play when you press a controller button
# and no browser is running. Deliberately NOT a boot autostart: the Pi being
# powered on does not mean anyone is riding.
ExecStart=/home/nirav/bike-controller/.venv/bin/python -u /home/nirav/bike-controller/tools/bridge.py --address E5:AD:49:06:75:76 --movement power --movement-max 75 --sprint-at 100 --poll-interval 0.05 --launch-on-input /home/nirav/bike-controller/tools/start-remoteplay.sh --status --ride-log /home/nirav/bike-rides
Restart=on-failure
RestartSec=5
# No StartLimit override: the "bike asleep at boot" case never exits the
# process (feed_from_bike retries internally, forever, by design), so disabling
# the limit bought nothing and only hid genuine hard failures -- a bad flag,
# a missing /dev/uinput, joydev not loaded -- behind an endless 5s restart loop
# instead of a clear `failed` state. Note StartLimit* belongs in [Unit] anyway.

[Install]
WantedBy=multi-user.target
