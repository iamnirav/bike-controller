# bike-controller configuration.
#
#   cp config.env.example config.env
#
# config.env is gitignored. Read by systemd (EnvironmentFile=), sourced by the
# shell scripts, and inherited by anything the bridge spawns.
#
# Almost everything here is optional. Paths come from wherever you cloned the
# repo, your username and UID are read at runtime, and the bike is found by its
# Bluetooth name. Only the console ID genuinely has to be supplied.

# REQUIRED. Open https://www.xbox.com/play/consoles in a browser, pick your
# console, and copy the ID out of the URL:
#   https://play.xbox.com/remoteplay/THIS_PART_HERE
XBOX_CONSOLE_ID=

# Optional. Bike BLE MAC. Leave blank to discover it by name (I_EB / I_SB),
# which is what you want unless you have two Icon machines in range.
BIKE_ADDRESS=

# Optional. The desktop user whose session Chromium runs in. Defaults to the
# user that ran install.sh. Only matters because the bridge runs as root.
DESKTOP_USER=

# Optional. Only used by tools/deploy.sh, if you develop on another machine.
# Its mDNS name, since a Pi's DHCP lease moves when you unplug it.
PI_HOST=

# Optional. Where ride CSVs are written. Defaults to $HOME/bike-rides.
# Keep this OUTSIDE the repo: ride logs are personal data and gitignored.
RIDE_LOG_DIR=

# --- Tuning -----------------------------------------------------------------
# Effort at which the left stick reaches full deflection, in watts.
MOVEMENT_MAX=75

# The baseline multiplier you always have, at any effort including none.
# 0.25 means the controller alone gives a quarter-speed walk and the bike buys
# the rest: 0 W -> 25%, MOVEMENT_MAX -> 100%. It also means bike-side faults
# (the console's restart delay, a freeze, a dropped link) leave you slow rather
# than stuck. 0 restores strict pedal-or-nothing.
MOVEMENT_FLOOR=0.25

# Effort at which sprint (left stick click) engages, in watts.
SPRINT_AT=100

# Seconds between BLE poll writes. Measured on one console: 0.2 -> 0.76 Hz,
# 0.05 -> ~2.0 Hz, 0.02 -> ~2.5 Hz, 0.01 -> no better. The rate varies between
# sessions, so measure yours (tools/live.py prints Hz) rather than trusting
# these. Telemetry rate sets how soon the game moves after you start pedalling.
# The fail-safe window is derived from this, so raising it also relaxes it.
POLL_INTERVAL=0.02

# Virtual pad output rate, 5-1000. Lower frees the event loop for BLE polling,
# at the cost of controller latency. Must stay above the telemetry rate or
# ride-log rows are dropped. 60 is right unless you are measuring something.
FRAME_RATE=60

# Seconds of bit-identical telemetry before the console counts as frozen and
# movement is zeroed. Observed once: it latched one reading and resent it
# unchanged for 30s, so pedalling stopped mattering entirely. Set 0 to disable.
FROZEN_AFTER=4

# Set either to 0 to disable game-rumble passthrough or ride logging.
RUMBLE_PASSTHROUGH=1
RIDE_LOG=1
